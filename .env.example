# GitHub API Token (Personal Access Token)
# 获取方式: https://github.com/settings/tokens -> Generate new token (classic)
# 需要权限: repo (仓库), user (用户)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# AI API 配置 (兼容 OpenAI 接口格式)
# 通义千问: base=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-plus
# 智谱 AI:  base=https://open.bigmodel.cn/api/paas/v4             model=glm-4.7-flash / glm-4-flash-250414
# DeepSeek:  base=https://api.deepseek.com/v1                    model=deepseek-chat
AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
AI_MODEL=qwen-plus

# RAG 配置
AI_SYSTEM_PROMPT="你是一个专业的代码分析助手。请基于提供的仓库上下文，用中文帮助用户理解代码、分析架构、解答问题。回答格式：使用 Markdown，代码块标注语言，关键点加粗。如果上下文不足请诚实说明。"
